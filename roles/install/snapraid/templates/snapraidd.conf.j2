# {{ ansible_managed }}

### System
sys_log_directory = {{ snapraid_daemon_log_directory }}
sys_log_retention_days = {{ snapraid_daemon_log_retention_days }}

### Network & REST API
net_enabled = {{ snapraid_daemon_net_enabled }}
{% if snapraid_daemon_net_port %}
net_port = {{ snapraid_daemon_net_port }}
{% endif %}
{% if snapraid_daemon_net_acl %}
net_acl = {{ snapraid_daemon_net_acl }}
{% endif %}
net_security_headers = 1
net_allowed_origin = self
net_config_full_access = 0
{% if snapraid_daemon_net_web_root %}
net_web_root = {{ snapraid_daemon_net_web_root }}
{% endif %}

### Automation & Maintenance
maintenance_schedule = {{ snapraid_daemon_maintenance_schedule }}
sync_threshold_deletes = {{ snapraid_daemon_sync_threshold_deletes }}
sync_threshold_updates = {{ snapraid_daemon_sync_threshold_updates }}
touch_zero_subseconds = {{ snapraid_daemon_touch_zero_subseconds }}
scrub_percentage = {{ snapraid_daemon_scrub_percentage }}
scrub_older_than = {{ snapraid_daemon_scrub_older_than }}

### Disk Monitoring & Power
probe_interval_minutes = {{ snapraid_daemon_probe_interval_minutes }}
spindown_idle_minutes = {{ snapraid_daemon_spindown_idle_minutes }}

### Notifications
notify_syslog_enabled = {{ snapraid_daemon_notify_syslog_enabled }}
notify_syslog_level = {{ snapraid_daemon_notify_syslog_level }}
notify_differences = {{ snapraid_daemon_notify_differences }}
notify_result_level = {{ snapraid_daemon_notify_result_level }}
hook_script = {{ snapraid_daemon_hook_script_path }}
notify_result = {{ snapraid_daemon_notify_script_path }} "%s" "%l"
